---
# Integration tests against the dev container.
#
# Triggered after `release` workflow succeeds on develop — pulls the
# `:vX.Y.Z-dev` image that release.yml just built, stands up the per-repo
# compose stack, runs `make test-integration`, reports a status check on the
# develop HEAD commit (so promotion-check can find it on the develop → main
# PR).
#
# Each repo customises deploy/test/compose.yml + the test target.
name: integration-tests

on:
  workflow_run:
    workflows: ["release"]
    types: [completed]
    branches: [develop]

permissions:
  contents: read
  packages: read
  statuses: write  # post commit status to develop HEAD

jobs:
  integration:
    if: github.event.workflow_run.conclusion == 'success'
    runs-on: ubuntu-latest
    env:
      GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ github.event.workflow_run.head_sha }}

      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: true

      - name: Read version
        id: version
        run: |
          set -euo pipefail
          [ -f VERSION ] || { echo "::error::no VERSION file"; exit 1; }
          VERSION=$(head -1 VERSION | tr -d '[:space:]')
          echo "version=${VERSION}" >> "$GITHUB_OUTPUT"

      - name: Log in to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Pull dev image
        env:
          IMAGE: ghcr.io/zelosai/${{ github.event.repository.name }}:v${{ steps.version.outputs.version }}-dev
        run: |
          set -euo pipefail
          docker pull "$IMAGE"
          echo "ZELOS_DEV_IMAGE=$IMAGE" >> "$GITHUB_ENV"

      - name: make test-integration
        run: make test-integration

      - name: Post status check on develop HEAD
        if: always()
        env:
          SHA: ${{ github.event.workflow_run.head_sha }}
          STATE: ${{ job.status == 'success' && 'success' || 'failure' }}
          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
        run: |
          gh api -X POST \
            "repos/${{ github.repository }}/statuses/${SHA}" \
            -f state="${STATE}" \
            -f context="integration-tests" \
            -f target_url="${RUN_URL}" \
            -f description="integration tests against :v${{ steps.version.outputs.version }}-dev"
