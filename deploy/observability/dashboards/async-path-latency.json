      "pluginVersion": "10.4.0",
      "title": "Enqueue vs reply rate",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum(rate(zelos_gateway_enqueued_total[$__rate_interval]))",
